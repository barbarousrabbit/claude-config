# === Sensitive — never sync ===
.credentials.json
settings.local.json
.mcp.json

# === Machine-specific — auto-generated per device ===
local-env.sh

# === Machine-local caches — auto-generated ===
projects/
sessions/
session-env/
telemetry/
debug/
file-history/
ide/
shell-snapshots/
todos/
backups/
plans/
tasks/
teams/

# === Third-party skill repos — installed per device ===
# These have their own git repos, so they are NOT tracked here. The clone URLs
# live in scripts/third-party-skills.tsv and bootstrap.sh installs them on a
# new device. Adding an entry here WITHOUT a matching manifest line is how a
# skill silently goes missing after a re-clone -- always update both.
skills/apple-hig-designer/

# === Runtime state — session-specific, not for sync ===
# .last-cleanup is a per-device timestamp rewritten every session. Tracking it
# made every pull conflict, which is how conflict markers landed in settings.json.
.last-cleanup
learnings-queue.json
plugins/installed_plugins.json
skills/docx/scripts/office/helpers/__pycache__/
skills/docx/scripts/office/validators/__pycache__/
**/__pycache__/
*.pyc

# === Plugin caches — auto-downloaded ===
plugins/cache/
plugins/marketplaces/
plugins/install-counts-cache.json
plugins/blocklist.json
plugins/known_marketplaces.json

# === Temporary files ===
temp/
*.jsonl
mcp-needs-auth-cache.json
