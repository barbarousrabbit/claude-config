projects/
sessions/
session-env/
telemetry/
debug/
file-history/
ide/
shell-snapshots/
todos/
backups/
plans/
tasks/
teams/

# === Third-party skill repos — installed per device ===
alireza-skills/

# === Runtime state — session-specific, not for sync ===
